---
import Logo from './Logo.astro';
import { email, phone, textHref, serviceHref, services } from '../data/site';
---
<footer class="footer"><div class="container">
  <div class="footer__top"><div><a class="footer__logo" href="/" aria-label="Clear Flow home"><Logo /></a><p>Exterior care, considered.<br />Coachella Valley, California.</p></div><div class="footer__contact"><a href={phone.href}>{phone.display}</a><a href={textHref}>Call or text</a><a class="footer__email" href={email.href}>{email.display}</a></div></div>
  <nav class="footer__services" aria-label="Explore our services">{services.map(service => <a href={serviceHref(service)}>{service.name}</a>)}</nav>
  <div class="footer__base"><span>© {new Date().getFullYear()} Clear Flow · Licensed &amp; Insured</span><nav aria-label="More information"><a href="/about/">About</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a></nav></div>
  <p class="footer__credit">Regional architecture photography: <a href="https://www.loc.gov/item/2010630225/">Carol M. Highsmith</a> / <a href="https://www.loc.gov/item/2013631255/">Library of Congress</a>. Shown for regional context.</p>
</div></footer>
<style>
.footer { padding-block: 4.5rem 2rem; }
.footer__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
.footer__logo { display: inline-flex; align-items: center; min-height: 44px; }
.footer__logo :global(.logo) { height: 2rem; }
.footer__top p { margin-top: .8rem; font-size: .73rem; color: var(--muted); }
.footer__contact { text-align: right; display: flex; flex-direction: column; align-items: flex-end; }
.footer__contact > a:first-child { font-family: var(--font-display); font-size: clamp(1.6rem,3vw,2.4rem); letter-spacing: -.045em; line-height: 1.2; text-decoration: none; white-space: nowrap; }
.footer__contact > a:nth-child(2) { font-size: .64rem; min-height: 36px; display: inline-flex; align-items: center; text-underline-offset: .3em; color: var(--muted); }
.footer__email { font-size: .71rem; text-decoration: none; color: var(--muted); overflow-wrap: anywhere; }
.footer__services { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2.7rem; padding-bottom: 1.7rem; border-bottom: 1px solid var(--hair); }
.footer__services a { font-size: .7rem; text-decoration: none; color: var(--muted); }
.footer a:hover { color: var(--teal-ink); }
.footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.5rem; font-size: .63rem; color: var(--muted); }
.footer__base nav { display: flex; gap: 1.5rem; }
.footer__base a { text-decoration: none; }
.footer__credit { margin-top: 1rem; font-size: .55rem; color: var(--muted); }
.footer__credit a { text-underline-offset: .2em; }
@media(max-width:767px) { .footer { padding-block: 3.5rem 6.5rem; } .footer__top { flex-direction: column; } .footer__contact { align-items: flex-start; text-align: left; } .footer__services { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; margin-top: 1.6rem; } .footer__services a, .footer__base nav a { display: flex; align-items: center; min-height: 44px; } .footer__base { flex-direction: column; align-items: flex-start; gap: .5rem; } }
</style>
