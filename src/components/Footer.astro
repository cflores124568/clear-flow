---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { phone, services } from '../data/site';
---

<footer class="footer">
	<div class="container footer__grid">
		<a class="footer__logo" href="#top" aria-label="Clear Flow, back to top">
			<Logo />
		</a>

		<div>
			<p class="label">Services</p>
			<ul>
				{
					services.map((s) => (
						<li>
							<a href="#services">{s.name}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p class="label">Visit</p>
			<ul>
				<li><a href="#how-it-works">How it works</a></li>
				<li><a href="#faq">FAQ</a></li>
				<li><a href="#quote">Request a quote</a></li>
			</ul>
		</div>

		<div>
			<p class="label">Licensed &amp; Insured</p>
			<a class="footer__phone link" href={phone.href}>
				<Icon name="phone" />
				{phone.display}
			</a>
		</div>
	</div>

	<div class="container footer__base">
		<span>Clear Flow</span>
		<span>Concept imagery</span>
	</div>
</footer>

<style>
	.footer {
		padding-top: clamp(3.5rem, 6vw, 5rem);
		background: var(--surface);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
		gap: 2rem;
		align-items: start;
	}

	.footer__logo {
		display: inline-flex;
		height: clamp(2.25rem, 3.6vw, 3.25rem);
		color: var(--ink);
	}

	.footer__grid > div {
		padding-left: 1.5rem;
		border-left: 1px solid var(--hair);
	}

	ul {
		list-style: none;
		margin: 0.9rem 0 0;
		padding: 0;
	}

	li + li {
		margin-top: 0.35rem;
	}

	li a {
		color: var(--muted);
		text-decoration: none;
	}

	li a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	.footer__phone {
		margin-top: 0.9rem;
		font-size: clamp(1.25rem, 1.9vw, 1.75rem);
	}

	.footer__base {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: clamp(3rem, 5vw, 4.5rem);
		padding-block: 1.5rem;
		border-top: 1px solid var(--hair);
		font-size: 0.9375rem;
		color: var(--muted);
	}

	@media (max-width: 1023px) {
		.footer__grid {
			grid-template-columns: 1fr 1fr;
			row-gap: 2.5rem;
		}

		.footer__logo {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 767px) {
		.footer {
			padding-bottom: 4.5rem;
		}

		.footer__grid {
			grid-template-columns: 1fr;
		}

		.footer__grid > div {
			padding-left: 0;
			padding-top: 1.5rem;
			border-left: 0;
			border-top: 1px solid var(--hair);
		}
	}
</style>
