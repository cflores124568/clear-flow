---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import heroClean from '../assets/photos/hero-clean.jpg';
import heroDusty from '../assets/photos/hero-dusty.jpg';
import { services } from '../data/site';

const widths = [768, 1280, 1800];
const sizes = '100vw';
---

<section class="hero" id="top" aria-labelledby="hero-title">
	<div class="hero__media" aria-hidden="true">
		<Picture
			class="hero__img"
			src={heroClean}
			widths={widths}
			sizes={sizes}
			formats={['avif', 'webp']}
			alt=""
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero__dusty">
			<Picture class="hero__img" src={heroDusty} widths={widths} sizes={sizes} formats={['avif', 'webp']} alt="" loading="eager" />
		</div>
		<div class="hero__edge"></div>
		<div class="hero__scrim"></div>
	</div>

	<div class="container hero__content">
		<h1 id="hero-title" class="display hero__title">Clear, from<br /> roof to curb.</h1>
		<p class="hero__sub">Solar panels, windows, concrete and clutter. One call, one quote.</p>

		<form class="starter" action="#quote" method="get" data-starter>
			<fieldset class="starter__set">
				<legend class="label starter__legend">What needs clearing?</legend>
				<div class="chips">
					{
						services.map((s) => (
							<label class="chip">
								<input type="checkbox" name="service" value={s.id} data-service={s.id} />
								<span>{s.chip}</span>
							</label>
						))
					}
				</div>
			</fieldset>
			<button class="btn starter__go" type="submit">
				Get my quote
				<Icon name="arrowRight" />
			</button>
		</form>

		<p class="hero__note">Licensed &amp; Insured</p>
	</div>
</section>

<style>
	/* The wipe: the dusty layer is clipped to everything left of a diagonal edge.
	   On load the edge sweeps in from the right (one squeegee pass); as the page
	   scrolls it keeps going until the glass is clear. */
	@property --wipe-in {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 62%;
	}

	@property --wipe-scroll {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 62%;
	}

	.hero {
		--wipe: min(var(--wipe-in), var(--wipe-scroll));
		--slant: 9%;
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: max(40rem, min(100svh, 62rem));
		padding-block: 8rem clamp(3rem, 7vh, 5.5rem);
		color: #fff;
		overflow: clip;
		background: var(--navy);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero {
			animation: wipe-in 1.9s var(--ease-wipe) 0.25s both;
		}

		@supports (animation-timeline: scroll()) {
			.hero {
				animation:
					wipe-in 1.9s var(--ease-wipe) 0.25s both,
					wipe-scroll linear both;
				animation-timeline: auto, scroll(root);
				animation-range:
					normal,
					0 90svh;
			}
		}
	}

	@keyframes wipe-in {
		from {
			--wipe-in: 112%;
		}
		to {
			--wipe-in: 62%;
		}
	}

	@keyframes wipe-scroll {
		from {
			--wipe-scroll: 62%;
		}
		to {
			--wipe-scroll: -12%;
		}
	}

	.hero__media {
		position: absolute;
		inset: 0;
	}

	.hero__media :global(picture),
	.hero__dusty {
		position: absolute;
		inset: 0;
	}

	.hero__media :global(.hero__img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 40%;
	}

	.hero__dusty {
		clip-path: polygon(
			0 0,
			calc(var(--wipe) + var(--slant)) 0,
			calc(var(--wipe) - var(--slant)) 100%,
			0 100%
		);
	}

	/* The wet line a squeegee blade leaves at the edge of the pass. */
	.hero__edge {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.6) 50%, rgb(255 255 255 / 0));
		clip-path: polygon(
			calc(var(--wipe) + var(--slant) - 0.25%) 0,
			calc(var(--wipe) + var(--slant) + 0.35%) 0,
			calc(var(--wipe) - var(--slant) + 0.35%) 100%,
			calc(var(--wipe) - var(--slant) - 0.25%) 100%
		);
		mix-blend-mode: screen;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(12 28 43 / 0.55) 0%, rgb(12 28 43 / 0) 22%),
			linear-gradient(30deg, rgb(12 28 43 / 0.82) 0%, rgb(12 28 43 / 0.5) 38%, rgb(12 28 43 / 0) 66%);
	}

	.hero__content {
		position: relative;
	}

	.hero__title {
		font-size: clamp(3.25rem, 7.6vw, 7rem);
		max-width: 11ch;
	}

	.hero__sub {
		margin-top: 1.5rem;
		max-width: 46ch;
		text-wrap: pretty;
		font-size: clamp(1.125rem, 1.6vw, 1.375rem);
		line-height: 1.45;
		color: rgb(255 255 255 / 0.92);
	}

	.starter {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		width: fit-content;
		max-width: 100%;
		margin-top: 2.25rem;
		padding: 1.25rem 1.25rem 1.25rem 1.5rem;
		border-radius: var(--radius);
		background: var(--panel);
		color: var(--ink);
	}

	.starter__set {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	.starter__legend {
		padding: 0;
		margin-bottom: 0.75rem;
		color: var(--ink);
	}

	.starter__go {
		align-self: stretch;
		padding-inline: 1.75rem;
		border-left: 1px solid transparent;
	}

	.hero__note {
		margin-top: 1.25rem;
		font-weight: 500;
		color: rgb(255 255 255 / 0.9);
	}

	@media (max-width: 1023px) {
		.starter {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			max-width: 34rem;
		}
	}

	@media (max-width: 767px) {
		.hero {
			--slant: 14%;
			min-height: auto;
			padding-block: 9rem 2.5rem;
		}

		.hero__scrim {
			background:
				linear-gradient(180deg, rgb(12 28 43 / 0.5) 0%, rgb(12 28 43 / 0) 20%),
				linear-gradient(0deg, rgb(12 28 43 / 0.9) 0%, rgb(12 28 43 / 0.45) 55%, rgb(12 28 43 / 0.1) 100%);
		}

		.starter {
			padding: 1rem;
		}

		.starter .chips {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}

		.starter .chip span {
			width: 100%;
		}
	}
</style>
