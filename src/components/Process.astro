---
import Icon from './Icon.astro';
const steps = [ { title: 'Tell us what needs clearing.', body: 'Choose your services and share a few property details.' }, { title: 'A price, made for your home.', body: 'We’ll put together your exact quote in under 24 hours.' }, { title: 'A time that works for you.', body: 'One crew arrives with the right tools for your visit.' } ];
---
<section class="process" id="how-it-works" aria-labelledby="process-title"><div class="container process__grid"><div data-reveal><p class="label">Effortless from the start</p><h2 id="process-title" class="display h2">A few details.<br /><em>Then it’s handled.</em></h2><a class="link" href="#quote">Build my quote<Icon name="arrowRight" /></a></div><ol>{steps.map((s,i)=><li data-reveal><span>{String(i+1).padStart(2,'0')}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></li>)}</ol></div></section>
<style>
.process { padding-block: var(--section); }
.process__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem,7vw,7rem); align-items: center; }
h2 { margin-top: 1.3rem; } h2 em { color: var(--teal); } .link { margin-top: 1.5rem; }
ol { list-style: none; padding: 0; margin: 0; } li { display: flex; gap: 1.5rem; padding-block: 1.5rem; border-top: 1px solid var(--hair); }
li > span { font-size: .7rem; color: var(--teal); padding-top: .2rem; } h3 { font-size: .92rem; font-weight: 500; } li p { margin-top: .6rem; font-size: .79rem; color: var(--muted); }
@media(max-width:767px) { .process__grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
