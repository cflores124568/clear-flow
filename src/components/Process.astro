---
import Icon from './Icon.astro';

const steps = [
	{ title: 'Tell us what needs clearing', body: 'Pick services online or call.' },
	{ title: 'Get your quote', body: 'A clear price for your property.' },
	{ title: 'Choose a time', body: 'We show up and handle the rest.' },
];
---

<section class="process" id="how-it-works" aria-labelledby="process-title">
	<div class="container process__grid">
		<h2 id="process-title" class="display h2 process__title" data-reveal>Three steps,<br /> then it's done.</h2>

		<div class="steps" data-draw>
			<svg class="steps__path" aria-hidden="true" data-steps-path>
				<polyline pathLength="1" />
			</svg>
			<ol>
				{
					steps.map((s, i) => (
						<li class="step" style={`--i:${i}`} data-reveal>
							<span class="step__num" aria-hidden="true">
								{i + 1}
							</span>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</li>
					))
				}
			</ol>
			<a class="btn steps__cta" href="#quote" data-reveal>
				Get a quote
				<Icon name="arrowRight" />
			</a>
		</div>
	</div>
</section>

<style>
	.process {
		padding-block: var(--section);
	}

	.process__grid {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.steps {
		position: relative;
	}

	.steps ol {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 3rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.step {
		padding-top: calc(var(--i) * clamp(2.5rem, 4.5vw, 4.25rem));
	}

	.steps__path {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.steps__path polyline {
		fill: none;
		stroke: var(--muted);
		stroke-opacity: 0.55;
		stroke-width: 1;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.js .steps__path polyline {
			stroke-dashoffset: 1;
			transition: stroke-dashoffset 1.8s var(--ease) 0.3s;
		}

		.js [data-draw].is-visible .steps__path polyline {
			stroke-dashoffset: 0;
		}

		.js .step[data-reveal] {
			--delay: calc(var(--i) * 0.18s);
		}
	}

	.step__num {
		display: block;
		font-size: clamp(4.5rem, 8vw, 7.5rem);
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: -0.04em;
		color: color-mix(in srgb, var(--muted), var(--surface) 45%);
		background: var(--surface);
		width: fit-content;
		padding-right: 0.15em;
	}

	.step h3 {
		margin-top: 1rem;
		font-size: clamp(1.25rem, 1.8vw, 1.625rem);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.step p {
		margin-top: 0.4rem;
		color: var(--muted);
	}

	.steps__cta {
		margin-top: 2rem;
		margin-left: calc((100% + clamp(1.5rem, 3vw, 3rem)) * 2 / 3);
	}

	@media (max-width: 1023px) {
		.process__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 767px) {
		.steps ol {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.step {
			display: grid;
			grid-template-columns: 4.5rem 1fr;
			column-gap: 1rem;
			padding: 1.5rem 0;
			border-top: 1px solid var(--hair);
		}

		.step__num {
			grid-row: span 2;
			font-size: 4rem;
		}

		.step h3 {
			margin-top: 0.35rem;
		}

		.steps__path {
			display: none;
		}

		.steps__cta {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
