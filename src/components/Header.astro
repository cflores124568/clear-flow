---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav as links, phone } from '../data/site';

interface Props {
	quoteHref?: string;
}

const { quoteHref = '#quote' } = Astro.props;
const here = Astro.url.pathname;
---

<header class="header" data-header>
	<div class="container header__bar">
		<a class="header__logo" href="/" aria-label="Clear Flow home">
			<Logo />
		</a>

		<nav class="header__nav" aria-label="Main">
			{
				links.map((l) => (
					<a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="header__actions">
			<a class="header__phone link" href={phone.href}>
				<Icon name="phone" />
				{phone.display}
			</a>
			<a class="btn header__cta" href={quoteHref}>
				Get a quote
				<Icon name="arrowRight" />
			</a>
			<button class="header__menu" type="button" popovertarget="menu" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
				<span class="menu-line"></span><span class="menu-line"></span>
			</button>
		</div>
	</div>

	<nav id="menu" class="menu" popover aria-label="Menu">
		<div class="menu__top">
			<Logo class="menu__logo" />
			<button class="header__menu" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">
				<Icon name="x" />
			</button>
		</div>
		<ul>
			{
				links.map((l) => (
					<li>
						<a href={l.href} data-close-menu>
							{l.label}
						</a>
					</li>
				))
			}
			<li>
				<a href={quoteHref} data-close-menu>Get a quote</a>
			</li>
		</ul>
		<a class="menu__phone" href={phone.href}>
			<Icon name="phone" />
			{phone.display}
		</a>
	</nav>
</header>

<style>
	.header {
		position: fixed;
		inset: 1.1rem var(--gutter) auto;
		border-radius: 10px;
		max-width: 1320px;
		margin-inline: auto;
		z-index: var(--z-header);
		color: #fff;
		transition:
			background-color 0.4s var(--ease),
			color 0.4s var(--ease),
			box-shadow 0.4s var(--ease);
	}

	.header.is-solid {
		color: var(--ink);
		background: color-mix(in srgb, var(--surface) 86%, transparent);
		backdrop-filter: blur(14px) saturate(1.4);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		box-shadow: var(--shadow), inset 0 0 0 1px rgb(255 255 255 / .6);
	}

	.header__bar {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 4.5rem;
		padding-inline: 1.3rem;

	}

	.is-solid .header__bar {
		height: 4.5rem;
	}

	.header__logo {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}

	.header__logo :global(.logo) {
		height: 1.65rem;

	}

	.is-solid .header__logo :global(.logo) {
		height: 1.65rem;
	}

	.header__nav {
		display: flex;
		gap: 1.8rem;
		font-size: .73rem;
		font-weight: 500;
	}

	.header__nav a {
		text-decoration: none;
		opacity: 0.92;
	}

	.header__nav a[aria-current='page'],
	.header__nav a:hover {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 0.35em;
		text-decoration-thickness: 1px;
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 1.6rem;
		margin-left: auto;
	}

	.header__cta {
		min-height: 2.9rem;
		padding: .35rem .4rem .35rem 1.1rem;
	}

	.header__menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		font-size: 1.5rem;
		position: relative;
		flex-direction: column;
		gap: 6px;
	}

	.menu {
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 1.25rem var(--gutter) 2rem;
		border: 0;
		background: var(--surface);
		color: var(--ink);
		flex-direction: column;
	}

	.menu:popover-open {
		display: flex;
	}

	.menu__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.menu :global(.menu__logo) {
		height: 1.65rem;
	}

	.menu .header__menu {
		display: inline-flex;
	}

	.menu ul {
		list-style: none;
		margin: 3rem 0 0;
		padding: 0;
	}

	.menu li a {
		display: block;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--hair);
		font-family: var(--font-display);
		font-size: 3rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.menu__phone {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: auto;
		font-size: 1.5rem;
		font-weight: 500;
		text-decoration: none;
	}

	@media (max-width: 1100px) {
		.header__menu { display: inline-flex; }
		.header__nav {
			display: none;
		}
	}

	@media (max-width: 767px) {
		.header { inset: .8rem 1rem auto; }
		.header__bar { padding-inline: .8rem; gap: 1rem; }
		.header__bar {
			height: 4.5rem;
		}

		.header__logo :global(.logo) {
			height: 1.6rem;
		}

		.header__phone,
		.header__cta {
			display: none;
		}

		.header__menu {
			display: inline-flex;
		}
	}
.header__phone { font-size: .73rem; }
	.menu-line { display: block; width: 21px; height: 1px; background: currentColor; transition: transform 250ms var(--spring); }
	.header__menu[aria-expanded="true"] .menu-line:first-child { transform: translateY(3.5px) rotate(45deg); }
	.header__menu[aria-expanded="true"] .menu-line:last-child { transform: translateY(-3.5px) rotate(-45deg); }
	.menu__top .header__menu { flex-direction: row; }
	@media (prefers-reduced-motion: no-preference) { .menu:popover-open li { animation: menu-enter 350ms var(--ease) both; } .menu:popover-open li:nth-child(2) { animation-delay: 30ms; } .menu:popover-open li:nth-child(3) { animation-delay: 60ms; } .menu:popover-open li:nth-child(4) { animation-delay: 90ms; } }
	@keyframes menu-enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
