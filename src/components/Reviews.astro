---
import Icon from './Icon.astro';
import { reviews, yelp } from '../data/site';
---
<section class="reviews" aria-labelledby="reviews-title"><div class="container">
  <div class="reviews__top" data-reveal><div><p class="label">Reviews from Yelp</p><h2 class="display h2" id="reviews-title">Neighbors,<br /><em>in their own words.</em></h2></div><a class="link" href={yelp.href} target="_blank" rel="noopener noreferrer"><img class="reviews__yelp" src={yelp.icon} width="45" height="45" alt="" />Read every review on Yelp<Icon name="arrowRight" /></a></div>
  <ul class="reviews__list">{reviews.map(r => <li data-reveal><figure><p class="reviews__rating">{r.rating} stars</p><blockquote>{r.title && <p class="reviews__title">“{r.title}</p>}<p>{r.title ? '' : '“'}{r.body}”</p></blockquote><figcaption>{r.name} <span>on Yelp</span></figcaption></figure></li>)}</ul>
</div></section>
<style>
.reviews { padding-block: var(--section); }
.reviews__top { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; }
.reviews__top h2 { margin-top: 1.4rem; }
.reviews__top h2 em { color: var(--teal-ink); }
.reviews__yelp { width: 1.4rem; height: 1.4rem; }
.reviews__list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 4rem); margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: 0; }
.reviews__list li { padding-top: 1.5rem; border-top: 1px solid var(--hair); }
.reviews__list figure { display: flex; flex-direction: column; height: 100%; margin: 0; }
.reviews__rating { font-size: .66rem; font-weight: 600; letter-spacing: .17em; text-transform: uppercase; color: var(--teal-ink); }
.reviews__list blockquote { margin: 1rem 0 0; font-size: .95rem; line-height: 1.65; }
.reviews__title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; letter-spacing: -.025em; line-height: 1.35; margin-bottom: .6rem; }
.reviews__list figcaption { margin-top: auto; padding-top: 1.5rem; font-size: .8rem; font-weight: 600; }
.reviews__list figcaption span { font-weight: 400; color: var(--muted); }
@media (max-width: 1023px) { .reviews__list { grid-template-columns: 1fr; } }
@media (max-width: 767px) { .reviews__top { flex-direction: column; align-items: flex-start; gap: 1rem; } }
</style>
