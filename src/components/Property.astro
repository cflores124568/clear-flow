---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import aerial from '../assets/photos/aerial.jpg';

// Pin positions are percentages of the photo, so they stay on target at any
// width. They are measured from aerial.jpg; re-measure if the photo changes.
const pins = [
	{ n: 1, label: 'Solar panels', x: 56.0, y: 31.3 },
	{ n: 2, label: 'Windows', x: 42.75, y: 45.3 },
	{ n: 3, label: 'Concrete', x: 72.5, y: 80.0, flip: true },
	{ n: 4, label: 'Haul-away', x: 18.0, y: 71.1 },
];
---

<section class="property" aria-labelledby="property-title">
	<figure class="property__figure" data-pins>
		<Picture
			class="property__img"
			src={aerial}
			widths={[768, 1280, 1920, 2400]}
			sizes="100vw"
			formats={['avif', 'webp']}
			alt="Aerial view of a tile-roof stucco home with rooftop solar panels, front windows, a concrete driveway and a pickup towing a trailer loaded for haul-away"
		/>
		<div class="property__scrim" aria-hidden="true"></div>
		<ol class="pins" aria-label="Where each service applies">
			{
				pins.map((p, i) => (
					<li class:list={['pin', { 'pin--flip': p.flip }]} style={`--x:${p.x}%;--y:${p.y}%;--i:${i}`}>
						<span class="pin__dot" aria-hidden="true">
							{p.n}
						</span>
						<span class="pin__label">{p.label}</span>
					</li>
				))
			}
		</ol>
	</figure>

	<div class="container property__copy">
		<h2 id="property-title" class="display h2">One visit.<br /> The whole property.</h2>
		<p class="property__sub">Bundle services into a single quote and a single trip.</p>
		<a class="link property__link" href="#quote">
			Build my quote
			<Icon name="arrowRight" />
		</a>
	</div>
</section>

<style>
	.property {
		position: relative;
		color: #fff;
		background: var(--navy);
	}

	.property__figure {
		position: relative;
		margin: 0;
		overflow: clip;
		container-type: inline-size;
	}

	.property__img {
		width: 100%;
		height: auto;
	}

	.property__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(160deg, rgb(12 28 43 / 0.82) 0%, rgb(12 28 43 / 0.55) 30%, rgb(12 28 43 / 0) 58%);
		pointer-events: none;
	}

	.property__copy {
		position: absolute;
		inset: clamp(1.75rem, 5.5vw, 5rem) 0 auto;
		pointer-events: none;
	}

	.property__copy > * {
		pointer-events: auto;
	}

	.property__copy .h2 {
		font-size: clamp(2rem, 4.6vw, 4.5rem);
	}

	.property__sub {
		margin-top: 1rem;
		font-size: clamp(1rem, 1.35vw, 1.25rem);
		color: rgb(255 255 255 / 0.9);
	}

	.property__link {
		margin-top: 1.5rem;
		font-size: 1.0625rem;
	}

	.pins {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.pin {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: flex;
		align-items: center;
		gap: 0.2cqw;
		transform: translate(calc(clamp(26px, 2.8cqw, 48px) / -2), -50%);
	}

	.pin__dot {
		display: grid;
		place-items: center;
		width: clamp(26px, 2.8cqw, 48px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--teal);
		color: #fff;
		font-weight: 600;
		font-size: clamp(12px, 1.25cqw, 20px);
		box-shadow: 0 0 0 0 rgb(63 182 198 / 0.55);
	}

	.pin__label {
		padding: 0.25em 0.6em 0.25em 0.75em;
		border-radius: var(--radius);
		background: rgb(12 28 43 / 0.78);
		font-weight: 600;
		font-size: clamp(12px, 1.3cqw, 21px);
		line-height: 1.3;
		white-space: nowrap;
	}

	/* Near the right edge on narrow screens, a pin's label sits on its left. */
	@container (max-width: 820px) {
		.pin--flip {
			flex-direction: row-reverse;
			transform: translate(calc(-100% + clamp(26px, 2.8cqw, 48px) / 2), -50%);
		}

		.pin--flip .pin__label {
			padding: 0.25em 0.75em 0.25em 0.6em;
		}
	}

	/* Pins light up one by one as the photo scrolls into view. */
	@media (prefers-reduced-motion: no-preference) {
		.js .pin {
			opacity: 0;
			transition: opacity 0.6s var(--ease);
			transition-delay: calc(var(--i) * 0.35s + 0.2s);
		}

		.js .pin__dot {
			transform: scale(0.4);
			transition: transform 0.7s var(--ease);
			transition-delay: inherit;
		}

		.js [data-pins].is-visible .pin {
			opacity: 1;
		}

		.js [data-pins].is-visible .pin__dot {
			transform: none;
			animation: ping 1.4s var(--ease) both;
			animation-delay: calc(var(--i) * 0.35s + 0.35s);
		}
	}

	@keyframes ping {
		from {
			box-shadow: 0 0 0 0 rgb(63 182 198 / 0.6);
		}
		to {
			box-shadow: 0 0 0 1.4em rgb(63 182 198 / 0);
		}
	}

	@media (max-width: 767px) {
		.property {
			display: flex;
			flex-direction: column-reverse;
		}

		.property__copy {
			position: static;
			padding-block: 3.5rem 2.5rem;
		}

		.property__scrim {
			display: none;
		}
	}
</style>
