---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import aerial from '../assets/photos/aerial.jpg';
const areas = [
  { id: 'solar', name: 'Up on the roof', detail: 'Soft-brush solar care' },
  { id: 'windows', name: 'Through every window', detail: 'Glass, frames & tracks' },
  { id: 'pressure', name: 'Out to the curb', detail: 'Driveways, patios & paths' },
  { id: 'junk', name: 'And out of your way', detail: 'Clutter, carried away' },
];
---
<section class="property" aria-labelledby="property-title">
  <div class="container property__grid">
    <div class="property__copy" data-reveal><div><p class="label">One visit, considered together</p><h2 id="property-title" class="display h2">The whole property.<br /><em>Off your list.</em></h2></div><div class="property__details"><p class="lede">No coordinating four companies. No repeating the same conversation. Just one crew, with the right tools for every part of your home.</p><a class="link" href="#quote">Put your visit together<Icon name="arrowRight" /></a><p class="property__note">Combine services. Ask us about bundle savings.</p></div></div>
    <figure class="property__figure" data-reveal>
      <div class="property__drawing">
        <Picture src={aerial} widths={[640, 1024, 1600, 2400]} sizes="92vw" formats={['avif', 'webp']} alt="Property illustration: a desert home with solar panels on the roof, broad front windows, a driveway and a haul-away trailer" loading="lazy" />
        {areas.map((area, i) => <button class:list={['property-pin', `property-pin--${area.id}`]} type="button" data-add={area.id} aria-pressed="false" aria-label={`Add ${area.detail.toLowerCase()} to quote`}><span data-label-off>{String(i + 1).padStart(2,'0')}</span><span data-label-on hidden>✓</span></button>)}
      </div>
      <figcaption><span>One home. One thoughtfully planned visit. · Property illustration</span><span>Select a point to add a service.</span></figcaption>
    </figure>
  </div>
  <ol class="container property__legend">{areas.map((area, i) => <li><span>{String(i + 1).padStart(2,'0')}</span><div><strong>{area.name}</strong><p>{area.detail}</p></div></li>)}</ol>
</section>
<style>
.property { padding-block: var(--section); background: var(--surface-alt); }
.property__copy { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,.75fr); gap: 3rem; align-items: end; }
.property__copy h2 { margin-top: 1.5rem; }
.property__copy h2 em { color: var(--teal); }
.property__copy .lede { margin-top: 1.5rem; font-size: .86rem; max-width: 46ch; }
.property__copy .link { margin-top: 1.5rem; font-size: .77rem; }
.property__note { margin-top: .3rem; font-size: .64rem; color: var(--muted); }
.property__figure { margin: 3rem 0 0; min-width: 0; }
.property__drawing { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 3px; background: var(--water-edge); }
.property__drawing :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
.property-pin { position: absolute; display: grid; place-items: center; width: 2.8rem; height: 2.8rem; padding: 0; border: 0; border-radius: 3px; background: var(--panel); color: var(--teal); font-size: .7rem; box-shadow: 0 5px 20px -5px rgb(29 95 150 / .2), inset 0 0 0 4px rgb(63 182 198 / .18); cursor: pointer; translate: -50% -50%; transition: transform 250ms var(--spring), background-color 250ms var(--ease); }
.property-pin:hover { transform: translateY(-3px); }
.property-pin[aria-pressed='true'] { background: var(--teal); color: var(--panel); }
.property-pin--solar { left: 56%; top: 28%; } .property-pin--windows { left: 49%; top: 57%; } .property-pin--pressure { left: 76%; top: 82%; } .property-pin--junk { left: 19%; top: 74%; }
figcaption { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .59rem; padding-top: .9rem; }
.property__legend { display: grid; grid-template-columns: 1.05fr 1.15fr 1.05fr 1fr; gap: 1.5rem; margin-top: 3rem; list-style: none; }
.property__legend li { display: flex; gap: 1rem; padding-top: 1.3rem; border-top: 1px solid var(--hair); }
.property__legend li > span { color: var(--teal-ink); font-size: .65rem; }
.property__legend strong { font-weight: 500; font-size: .76rem; }
.property__legend p { font-size: .67rem; color: var(--muted); margin-top: .3rem; }
@media (max-width: 767px) { .property__copy { grid-template-columns: 1fr; gap: .75rem; } .property__figure { margin-top: 2rem; } .property__legend { grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; margin-top: 2rem; } figcaption { flex-direction: column; gap: .2rem; } .property-pin { width: 2.75rem; height: 2.75rem; } }
</style>
