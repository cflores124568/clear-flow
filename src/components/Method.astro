---
import { Image } from 'astro:assets';
import methodPhoto from '../assets/photos/method-window.jpg';

// Proposed method lines. Each one is a promise about how the work is done, so
// the owner confirms them before launch.
const points = [
	{ title: 'Pure water on solar', body: 'No pressure washers on panels, ever.' },
	{ title: 'Right tool, every surface', body: 'Soft wash where needed, pressure only on concrete.' },
	{ title: 'Licensed & Insured', body: 'Covered on every job.' },
	{ title: 'Left cleaner than we found it', body: 'Hauled, swept and rinsed before we go.' },
];
---

<section class="method" aria-labelledby="method-title">
	<div class="container method__grid">
		<div class="method__copy">
			<p class="label" data-reveal>How we work</p>
			<h2 id="method-title" class="display h2 method__title" data-reveal>Careful is the<br /> whole point.</h2>
			<ul class="method__list">
				{
					points.map((p, i) => (
						<li data-reveal style={`--delay:${i * 0.08}s`}>
							<h3>{p.title}</h3>
							<p>{p.body}</p>
						</li>
					))
				}
			</ul>
		</div>

		<figure class="method__figure" data-reveal>
			<div class="method__frame">
				<Image
					src={methodPhoto}
					widths={[480, 760, 1100]}
					sizes="(min-width: 1024px) 40vw, 100vw"
					alt="A worker on the ground cleaning a second-story window with a water-fed pole, a pure-water filter cart beside them"
				/>
			</div>
			<figcaption>Pure-water rinse, no detergent residue.</figcaption>
		</figure>
	</div>
</section>

<style>
	.method {
		padding-block: var(--section);
		background: var(--surface-alt);
	}

	.method__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.method__title {
		margin-top: 1rem;
	}

	.method__list {
		list-style: none;
		margin: clamp(2rem, 4vw, 3.25rem) 0 0;
		padding: 0;
		max-width: 38rem;
	}

	.method__list li {
		padding-block: 1.4rem;
		border-bottom: 1px solid var(--hair);
	}

	.method__list li:first-child {
		padding-top: 0;
	}

	.method__list li:last-child {
		border-bottom: 0;
	}

	.method__list h3 {
		font-size: clamp(1.25rem, 1.8vw, 1.625rem);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.method__list p {
		margin-top: 0.3rem;
		color: var(--muted);
	}

	.method__figure {
		margin: 0;
	}

	.method__frame {
		aspect-ratio: 9 / 10;
		overflow: hidden;
	}

	.method__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	@media (max-width: 1023px) {
		.method__grid {
			grid-template-columns: 1fr;
		}

		.method__figure {
			order: -1;
		}

		.method__frame {
			aspect-ratio: 4 / 3;
		}
	}
</style>
