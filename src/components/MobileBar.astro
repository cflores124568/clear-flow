---
import Icon from './Icon.astro';
import { phone } from '../data/site';

interface Props {
	quoteHref?: string;
}

const { quoteHref = '#quote' } = Astro.props;
---

<nav class="mbar" aria-label="Quick actions" data-mbar>
	<a class="mbar__call" href={phone.href}>
		<Icon name="phone" />
		<span>
			<strong>Call</strong>
			{phone.display}
		</span>
	</a>
	<a class="mbar__quote" href={quoteHref}>
		Get a quote
		<Icon name="arrowRight" />
	</a>
</nav>

<style>
	.mbar {
		display: none;
	}

	@media (max-width: 767px) {
		.mbar {
			position: fixed;
			inset: auto 0 0;
			z-index: 30;
			display: grid;
			grid-template-columns: 1fr 1fr;
			padding-bottom: env(safe-area-inset-bottom);
			background: var(--navy);
			transition: transform 0.45s var(--ease);
		}

		.mbar.is-hidden {
			transform: translateY(110%);
		}

		.mbar a {
			display: flex;
			align-items: center;
			gap: 0.7rem;
			min-height: 4rem;
			padding: 0 1.25rem;
			text-decoration: none;
			font-weight: 600;
		}

		.mbar__call {
			color: #fff;
		}

		.mbar__call :global(.icon) {
			font-size: 1.3rem;
		}

		.mbar__call span {
			display: flex;
			flex-direction: column;
			font-weight: 500;
			font-size: 0.875rem;
			line-height: 1.25;
		}

		.mbar__call strong {
			font-size: 1rem;
			font-weight: 600;
		}

		.mbar__quote {
			justify-content: space-between;
			background: var(--teal);
			color: var(--on-teal);
		}
	}
</style>
