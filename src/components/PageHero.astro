---
// Top of every inner page. With a photo it is a shorter cousin of the home
// hero; without one it is a navy band. Either way the header sits over it.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	label?: string;
	lede?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

const { title, label, lede, image, imageAlt = '' } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--photo': image }]} data-hero aria-labelledby="page-title">
	{
		image && (
			<div class="page-hero__media">
				<Picture
					src={image}
					widths={[768, 1280, 1920]}
					sizes="100vw"
					formats={['avif', 'webp']}
					alt={imageAlt}
					loading="eager"
					fetchpriority="high"
				/>
				<div class="page-hero__scrim" aria-hidden="true" />
			</div>
		)
	}
	<div class="container page-hero__content">
		{label && <p class="label page-hero__label">{label}</p>}
		<h1 id="page-title" class="display page-hero__title">{title}</h1>
		{lede && <p class="page-hero__lede">{lede}</p>}
		<slot />
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: clamp(20rem, 46vh, 28rem);
		padding-block: 8rem clamp(2.5rem, 5vw, 4rem);
		background: var(--navy);
		color: #fff;
		overflow: clip;
	}

	.page-hero--photo {
		min-height: clamp(28rem, 72vh, 44rem);
	}

	.page-hero__media,
	.page-hero__media :global(picture),
	.page-hero__scrim {
		position: absolute;
		inset: 0;
	}

	.page-hero__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-hero__scrim {
		background:
			linear-gradient(180deg, rgb(26 44 56 / 0.55) 0%, rgb(26 44 56 / 0) 25%),
			linear-gradient(30deg, rgb(26 44 56 / 0.85) 0%, rgb(26 44 56 / 0.5) 42%, rgb(26 44 56 / 0.05) 72%);
	}

	.page-hero__content {
		position: relative;
	}

	.page-hero__label {
		color: var(--aqua-light);
	}

	.page-hero__title {
		margin-top: 0.75rem;
		font-size: clamp(2.75rem, 6.4vw, 6rem);
		max-width: 16ch;
	}

	.page-hero__lede {
		margin-top: 1.25rem;
		max-width: 48ch;
		font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
		line-height: 1.5;
		color: rgb(255 255 255 / 0.9);
		text-wrap: pretty;
	}
</style>
