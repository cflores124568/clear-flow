---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { serviceHref, services, coreServices } from '../data/site';
import { servicePhotos as photos, servicePhotoAlts } from '../data/photos';

interface Props {
	// The services page already has an h1 saying this, so it hides the heading.
	showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
const displayedServices = showHeading ? coreServices : services;
---

<section class="services" id="services" aria-labelledby={showHeading ? 'services-title' : undefined} aria-label={showHeading ? undefined : 'Services'}>
	<div class="container">
		{
			showHeading && (
				<>
					<p class="label" data-reveal>
						Services
					</p>
					<h2 id="services-title" class="display h2 services__title" data-reveal>
						Four services. <em>One standard of care.</em>
					</h2>
				</>
			)
		}

		<p class="services__intro" data-reveal>Pick the care your home needs. We’ll take it from there.</p>
		<div class="services__body" data-services>
			<ol class="svc-list">
				{
					displayedServices.map((s, i) => (
						<li class:list={['svc', { 'is-active': i === 0 }]} data-svc={i} data-caption={s.caption} data-reveal style={`--delay:${i * 0.08}s`}>
							<a class="svc__photo" href={serviceHref(s)} aria-label={`Explore ${s.name.toLowerCase()}`}>
								<Picture src={photos[s.id]} widths={[400, 640, 960]} sizes="(max-width: 767px) 92vw, 1px" formats={['avif', 'webp']} alt={servicePhotoAlts[s.id]} loading="lazy" />
							</a>
							<span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
							<div class="svc__text">
								<h3 class="svc__name">
									<a href={serviceHref(s)}>{s.name}</a>
								</h3>
								<p class="svc__line">{s.line}</p>
							</div>
							<button class="svc__add" type="button" data-add={s.id} aria-pressed="false">
								<span class="svc__add-label" data-label-off>
									Add to quote
								</span>
								<span class="svc__add-label" data-label-on hidden>
									Added
								</span>
								<Icon name="plus" class="svc__add-plus" />
								<Icon name="check" class="svc__add-check" />
							</button>
						</li>
					))
				}
			</ol>

			<div class="svc-media" aria-hidden="true" data-svc-media>
				<div class="svc-media__frame">
					{
						displayedServices.map((s, i) => (
							<Picture
								class:list={['svc-media__img', { 'is-active': i === 0 }]}
								src={photos[s.id]}
								widths={[480, 720, 1080]}
								sizes="(min-width: 768px) 46vw, 1px"
								formats={['avif', 'webp']}
								alt=""
								loading="lazy"
								data-svc-img={i}
							/>
						))
					}
				</div>
				<p class="svc-media__caption" data-svc-caption>{displayedServices[0].caption}</p>
			</div>
		</div>
	</div>
</section>

<style>
	.services {
		padding-block: var(--section);
	}

	.services__intro { margin-top: 1.1rem; font-size: .82rem; color: var(--muted); }
	.services__title em { color: var(--teal); }
	.services__title {
		margin-top: 1rem;
	}

	.services__body:first-child {
		margin-top: 0;
	}

	.services__body {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, .95fr) minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 4rem);
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
	}

	.svc-list {
		grid-column: 2;
		grid-row: 1;
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--hair);
	}

	.svc {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		align-items: start;
		gap: 0 1rem;
		padding-block: clamp(1.25rem, 2vw, 1.8rem);
		border-bottom: 1px solid var(--hair);
		cursor: default;
	}

	.svc__num {
		padding-top: 0.6em;
		color: var(--muted);
		font-size: .65rem;
	}

	.svc__text {
		transition: transform 250ms var(--spring);
	}
	.svc__photo { display: none; }

	.svc.is-active .svc__text {
		transform: translateX(0.3rem);
	}

	.svc__name {
		font-size: clamp(1.3rem, 2.15vw, 2rem);
		font-family: var(--font-display);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.02;
	}

	.svc__name a {
		display: inline-block;
		min-height: 44px;
		text-decoration: none;
	}

	.svc__name a:hover {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.12em;
	}

	.svc__line {
		margin-top: 0.6rem;
		color: var(--muted);
		font-size: .77rem;
	}

	.svc__add {
		grid-column: 2;
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 2.75rem;
		margin-top: 0.5rem;
		padding: 0;
		border: 0;
		background: none;
		font-weight: 500;
		font-size: .7rem;
		cursor: pointer;
		white-space: nowrap;
	}

	.svc__add-label {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
	}

	.svc__add :global(.icon) {
		font-size: 1.3rem;
	}

	.svc__add :global(.svc__add-check),
	.svc__add[aria-pressed='true'] :global(.svc__add-plus) {
		display: none;
	}

	.svc__add[aria-pressed='true'] :global(.svc__add-check) {
		display: inline-flex;
	}

	.svc.is-active .svc__add,
	.svc__add[aria-pressed='true'] {
		color: var(--teal-ink);
	}

	.svc-media {
		position: sticky;
		top: 7.5rem;
		align-self: start;
		grid-column: 1;
		grid-row: 1;
	}

	.svc-media__frame {
		position: relative;
		aspect-ratio: 4 / 3;
		border-radius: 3px;
		overflow: hidden;
		background: var(--surface-alt);
	}

	.svc-media__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transform: scale(1.015);
		transition:
			opacity 250ms var(--ease),
			transform 300ms var(--ease);
	}

	.svc-media__img.is-active {
		opacity: 1;
		transform: none;
	}

	.svc-media__caption {
		margin-top: 0.75rem;
		font-size: .62rem;
		color: var(--muted);
	}

	@media (max-width: 767px) {
		.services__body {
			grid-template-columns: 1fr;
		}

		.svc-media {
			display: none;
		}
		.svc-list { grid-column: 1; border-top: 0; }
		.svc:first-child { padding-top: 0; }
		.svc__photo { display: block; grid-column: 1 / -1; aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: 1.4rem; background: var(--surface-alt); border-radius: 3px; }
		.svc__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

		.svc {
			grid-template-columns: 2.5rem minmax(0, 1fr);
			padding-block: 2rem;
		}

		.svc__add {
			grid-column: 2;
			margin-top: 0.75rem;
			justify-self: start;
		}

		.svc.is-active .svc__text {
			transform: none;
		}

		.svc.is-active .svc__add:not([aria-pressed='true']) {
			color: inherit;
		}
	}
</style>
