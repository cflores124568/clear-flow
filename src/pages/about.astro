---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import Method from '../components/Method.astro';
import Process from '../components/Process.astro';
import Quote from '../components/Quote.astro';
import aerial from '../assets/photos/aerial.jpg';
---

<Page
	title="About | Clear Flow"
	description="Clear Flow cleans solar panels, windows and concrete and hauls away junk, all on one quote. Licensed & Insured. Call 760-422-3069."
>
	<PageHero
		label="About"
		title="The outside of your home, handled."
		lede="Clear Flow cleans solar panels, windows and concrete, and hauls away what you no longer need. One call, one quote, Licensed & Insured."
		image={aerial}
		imageAlt="A tile-roof home with rooftop solar panels and a concrete driveway"
	/>
	<Method />
	<Process />
	<Quote />
</Page>
