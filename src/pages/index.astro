---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Property from '../components/Property.astro';
import Method from '../components/Method.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---

<Base
	title="Clear Flow | Solar Panel Cleaning, Window Cleaning, Pressure Washing and Junk Removal"
	description="Solar panel cleaning, window cleaning, pressure washing and junk removal on one quote. Licensed & Insured. Call 760-422-3069."
>
	<Header />
	<main id="main">
		<Hero />
		<Services />
		<Property />
		<Method />
		<Process />
		<Faq />
		<Quote />
	</main>
	<Footer />
	<MobileBar />
</Base>

<script>
	import '../scripts/site';
</script>
